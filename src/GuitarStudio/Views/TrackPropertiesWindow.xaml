<Window x:Class="GuitarStudio.Views.TrackPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traccia" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgPanel}" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20" MinWidth="420">
        <TextBlock x:Name="Header" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nome"/>
            <TextBox x:Name="NameBox" Grid.Column="1"/>

            <TextBlock Grid.Row="1" Text="Tipo"/>
            <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="TypeCombo_SelectionChanged">
                <ComboBoxItem Content="Chitarra 6 corde" Tag="6"/>
                <ComboBoxItem Content="Chitarra 7 corde" Tag="7"/>
                <ComboBoxItem Content="Basso 4 corde" Tag="4b"/>
                <ComboBoxItem Content="Basso 5 corde" Tag="5b"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Suono"/>
            <ComboBox x:Name="InstrumentCombo" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Grid.Row="3" Text="Accordatura"/>
            <ComboBox x:Name="TuningCombo" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Grid.Row="4" Text="Capotasto"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="CapoCombo" Width="70"/>
                <TextBlock Text="(i numeri nella tab restano relativi al capotasto)" Foreground="{StaticResource TextDim}" FontSize="12" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Annulla" IsCancel="True" Width="90"/>
            <Button Style="{StaticResource ToolButton}" Content="OK" IsDefault="True" Width="90" Click="Ok_Click" Background="{StaticResource Accent}" Foreground="#1E1F24"/>
        </StackPanel>
    </StackPanel>
</Window>
