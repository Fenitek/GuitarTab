<Window x:Class="GuitarStudio.Views.TrackPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuova traccia" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgPanel}" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="26,22,26,22" Width="480">
        <TextBlock Text="Nuova traccia" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,16"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Nome" Style="{StaticResource RowLabel}"/>
            <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Tipo" Style="{StaticResource RowLabel}"/>
            <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="TypeCombo_SelectionChanged">
                <ComboBoxItem Content="Chitarra 6 corde" Tag="6"/>
                <ComboBoxItem Content="Chitarra 7 corde" Tag="7"/>
                <ComboBoxItem Content="Basso 4 corde" Tag="4b"/>
                <ComboBoxItem Content="Basso 5 corde" Tag="5b"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Suono" Style="{StaticResource RowLabel}"/>
            <ComboBox x:Name="InstrumentCombo" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Text="Accordatura" Style="{StaticResource RowLabel}"/>
            <ComboBox x:Name="TuningCombo" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="4" Text="Capotasto" Style="{StaticResource RowLabel}"/>
            <ComboBox x:Name="CapoCombo" Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="Con il capotasto i numeri nella tab restano relativi al capotasto." Foreground="{StaticResource TextDim}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,-8,0">
            <Button Style="{StaticResource ToolButton}" Content="Annulla" IsCancel="True" MinWidth="104"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Aggiungi" IsDefault="True" MinWidth="104" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
