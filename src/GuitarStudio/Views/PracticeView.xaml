<UserControl x:Class="GuitarStudio.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:at="clr-namespace:AlphaTab.Wpf;assembly=AlphaTab.Windows"
             xmlns:views="clr-namespace:GuitarStudio.Views"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="View_PreviewKeyDown">

    <Grid x:Name="WorkspaceGrid" SizeChanged="Workspace_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="BodyRow" Height="*" MinHeight="140"/>
            <RowDefinition x:Name="TracksDividerRow" Height="6"/>
            <RowDefinition x:Name="TracksRow" Height="34" MinHeight="34"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== BARRA SUPERIORE ============================== -->
        <Border x:Name="TransportBar" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid x:Name="ToolbarLayout" SizeChanged="Toolbar_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ToolbarCore">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="18" Width="38" Click="Play_Click" IsEnabled="False" ToolTip="Play / Pausa (Spazio)" AutomationProperties.Name="Play o pausa"/>
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Click="Stop_Click" IsEnabled="False" ToolTip="Stop (Maiusc+Spazio)" AutomationProperties.Name="Stop"/>
                    </StackPanel>
                    <Border x:Name="TransportDisplay" Grid.Column="1" Background="{StaticResource BgDeep}" CornerRadius="6" Padding="10,3" Margin="8,0" MinWidth="260" MaxWidth="420" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="LcdTempo" DockPanel.Dock="Right" Text="♩ = 120" Foreground="{StaticResource TextDim}" FontSize="13" Margin="10,0,0,0"/>
                                <TextBlock x:Name="LcdTrack" Text="—" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="LcdBar" Text="1/1" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                                <TextBlock x:Name="LcdSig" Text="4/4" Foreground="{StaticResource TextDim}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="12,0,0,0"/>
                                <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="SpeedGroup" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                        <Slider x:Name="SpeedSlider" Width="100" Minimum="25" Maximum="150" Value="100" Focusable="False" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SpeedSlider_ValueChanged" ToolTip="Velocità 25–150% (Ctrl+Pag↑ / Pag↓)" AutomationProperties.Name="Velocità di riproduzione"/>
                        <TextBlock x:Name="SpeedText" Text="100%" Width="44" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource ToolButton}" Content="Altro ▾" Margin="0" Padding="10,6" VerticalAlignment="Center" Click="More_Click" ToolTip="Altri comandi e spazio partitura (F10)" AutomationProperties.Name="Altri comandi">
                        <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                    </Button>
                </Grid>
                <StackPanel x:Name="SecondaryCommands" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <ToggleButton x:Name="PaletteToggle" Style="{StaticResource IconToggle}" Content="&#xE90C;" IsChecked="True" Click="PanelToggle_Click" ToolTip="Tavolozza di modifica (F2)"/>
                    <ToggleButton x:Name="TracksToggle" Style="{StaticResource IconToggle}" Content="&#xE90E;" IsChecked="True" Click="PanelToggle_Click" ToolTip="Pannello tracce (F3)"/>
                    <ToggleButton x:Name="InspectorToggle" Style="{StaticResource IconToggle}" Content="&#xE90D;" IsChecked="True" Click="PanelToggle_Click" ToolTip="Proprietà Brano / Traccia / Battuta (F4)"/>
                    <ToggleButton x:Name="FretToggle" Style="{StaticResource IconToggle}" Click="FretToggle_Click" ToolTip="Mostra o nascondi il manico (F6)"><TextBlock Text="Manico" FontFamily="{StaticResource UiFont}" FontSize="13"/></ToggleButton>
                    <Border Style="{StaticResource SeparatorLine}"/>
                    <Button x:Name="FileMenuButton" Style="{StaticResource IconButton}" Content="&#xE700;" Click="FileMenu_Click" ToolTip="Menu file (Alt+F)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nuova tablatura" InputGestureText="Ctrl+N" Click="New_Click"/>
                                <MenuItem Header="Apri…" InputGestureText="Ctrl+O" Click="Open_Click"/>
                                <MenuItem x:Name="RecentMenu" Header="Apri recente"/>
                                <MenuItem Header="Apri l'esercizio demo" Click="Demo_Click"/>
                                <Separator/>
                                <MenuItem Header="Salva" InputGestureText="Ctrl+S" Click="Save_Click"/>
                                <MenuItem Header="Salva come…" InputGestureText="Ctrl+Maiusc+S" Click="SaveAs_Click"/>
                                <MenuItem Header="Esporta MIDI…" Click="ExportMidi_Click"/>
                                <Separator/>
                                <MenuItem Header="Scegli un SoundFont…" Click="ChooseSoundFont_Click"/>
                                <MenuItem x:Name="DefaultSoundFontItem" Header="Usa il SoundFont incluso" Click="DefaultSoundFont_Click"/>
                                <Separator/>
                                <MenuItem Header="Guida rapida e scorciatoie" InputGestureText="F1" Click="Help_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" Click="New_Click" ToolTip="Nuova tablatura (Ctrl+N)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Apri (Ctrl+O)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Click="Save_Click" ToolTip="Salva (Ctrl+S)"/>
                    <Border Style="{StaticResource SeparatorLine}"/>
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Annulla (Ctrl+Z)"/>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Ripeti (Ctrl+Y)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="GoStart_Click" ToolTip="All'inizio (Ctrl+Home)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="PrevBar_Click" ToolTip="Battuta precedente (Ctrl+←)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="NextBar_Click" ToolTip="Battuta successiva (Ctrl+→)"/>
                    <Border Style="{StaticResource SeparatorLine}"/>
                    <ToggleButton x:Name="LoopToggle" Style="{StaticResource IconToggle}" Content="&#xE8EE;" Click="LoopToggle_Click" ToolTip="Loop: ripeti la selezione (F7)"/>
                    <ToggleButton x:Name="MetronomeToggle" Style="{StaticResource IconToggle}" Click="MetronomeToggle_Click" ToolTip="Metronomo (F8)"><TextBlock Text="♩" FontFamily="{StaticResource MusicFont}" FontSize="17"/></ToggleButton>
                    <ToggleButton x:Name="CountInToggle" Style="{StaticResource IconToggle}" Click="CountInToggle_Click" ToolTip="Conteggio iniziale (F9)"><TextBlock Text="1-2" FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"/></ToggleButton>
                    <ToggleButton x:Name="TrainerToggle" Style="{StaticResource IconToggle}" Content="&#xE916;" Click="TrainerToggle_Click" ToolTip="Speed trainer (Ctrl+F10)"/>
                </StackPanel>
                    <Popup x:Name="TrainerPopup" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" PlacementTarget="{Binding ElementName=TrainerToggle}" Placement="Bottom" StaysOpen="False"
                           Closed="TrainerPopup_Closed">
                        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,10">
                            <StackPanel Width="270">
                                <TextBlock Text="Speed trainer" Style="{StaticResource PanelHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="A ogni ripetizione del loop la velocità sale fino all'obiettivo." Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" FontSize="13"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Parti da %" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TrainerStart" Text="60"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="Arriva a %" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TrainerTarget" Text="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="+ % a giro" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TrainerStep" Text="5"/>
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="TrainerActionButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Content="Attiva" Click="TrainerStart_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
            </Grid>
        </Border>

        <!-- ============================== CORPO ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaletteColumn" Width="190" MinWidth="190" MaxWidth="440"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="250" MinWidth="250" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- Tavolozza di modifica -->
            <Border x:Name="PalettePanel" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12,0,6,14">
                        <TextBlock Text="VOCE" Style="{StaticResource SectionHeader}"/>
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="VoiceOne" Style="{StaticResource ToolToggle}" Content="1 ↑" Tag="0" MinWidth="60" Margin="0,0,4,0"
                                          Click="Voice_Click" ToolTip="Voce 1: melodia (Ctrl+Alt+1)" AutomationProperties.Name="Voce 1, melodia"/>
                            <ToggleButton x:Name="VoiceTwo" Style="{StaticResource ToolToggle}" Content="2 ↓" Tag="1" MinWidth="60" Margin="0,0,0,0"
                                          Click="Voice_Click" ToolTip="Voce 2: accompagnamento (Ctrl+Alt+2)" AutomationProperties.Name="Voce 2, accompagnamento"/>
                        </UniformGrid>
                        <TextBlock Text="Durate indipendenti nella stessa battuta." Foreground="{StaticResource TextDim}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,6,6,2"/>
                        <TextBlock Text="DURATA" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <ToggleButton x:Name="DurWhole" Style="{StaticResource PaletteToggle}" Tag="1" Click="Duration_Click" ToolTip="Semibreve: 4 movimenti">
                                <TextBlock Text="&#x1D15D;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DurHalf" Style="{StaticResource PaletteToggle}" Tag="2" Click="Duration_Click" ToolTip="Minima: 2 movimenti">
                                <TextBlock Text="&#x1D15E;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DurQuarter" Style="{StaticResource PaletteToggle}" Tag="4" Click="Duration_Click" ToolTip="Semiminima: 1 movimento">
                                <TextBlock Text="&#x1D15F;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DurEighth" Style="{StaticResource PaletteToggle}" Tag="8" Click="Duration_Click" ToolTip="Croma: ½ movimento">
                                <TextBlock Text="&#x1D160;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DurSixteenth" Style="{StaticResource PaletteToggle}" Tag="16" Click="Duration_Click" ToolTip="Semicroma: ¼ di movimento">
                                <TextBlock Text="&#x1D161;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DurThirtySecond" Style="{StaticResource PaletteToggle}" Tag="32" Click="Duration_Click" ToolTip="Biscroma">
                                <TextBlock Text="&#x1D162;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </ToggleButton>
                            <ToggleButton x:Name="DotToggle" Style="{StaticResource PaletteToggle}" Click="Dot_Click" ToolTip="Nota puntata (tasto .)">
                                <TextBlock Text="♩." FontFamily="{StaticResource MusicFont}" FontSize="16"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TupletToggle" Style="{StaticResource PaletteToggle}" Click="Tuplet_Click" ToolTip="Terzina (Ctrl+3)">
                                <TextBlock Text="-3-" FontSize="13" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <Button Style="{StaticResource PaletteButton}" Click="Rest_Click" ToolTip="Trasforma in pausa (R)">
                                <TextBlock Text="&#x1D13D;" FontFamily="{StaticResource MusicFont}" FontSize="19"/>
                            </Button>
                        </WrapPanel>

                        <!-- Effetti: sezioni generate dal codice -->
                        <StackPanel x:Name="EffectsHost"/>

                        <TextBlock Text="MODIFICA" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PaletteButton}" Content="&#xE8C8;" FontFamily="{StaticResource IconFont}" Click="Copy_Click" ToolTip="Copia: la selezione, o la battuta se non c'è selezione (Ctrl+C)"/>
                            <Button Style="{StaticResource PaletteButton}" Content="&#xE8C6;" FontFamily="{StaticResource IconFont}" Click="Cut_Click" ToolTip="Taglia (Ctrl+X)"/>
                            <Button x:Name="PasteButton" Style="{StaticResource PaletteButton}" Content="&#xE77F;" FontFamily="{StaticResource IconFont}" Click="Paste_Click" ToolTip="Incolla (Ctrl+V)"/>
                            <Button Style="{StaticResource PaletteButton}" Content="&#xE8B3;" FontFamily="{StaticResource IconFont}" Click="SelectAll_Click" ToolTip="Seleziona tutta la traccia (Ctrl+A)"/>
                        </WrapPanel>

                        <TextBlock Text="BATTUTE E TEMPI" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PaletteButton}" Click="InsertBeat_Click" ToolTip="Inserisci un tempo prima del cursore (Ins)">
                                <TextBlock Text="+♩" FontFamily="{StaticResource MusicFont}" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource PaletteButton}" Click="DeleteBeat_Click" ToolTip="Elimina il tempo (Ctrl+Canc)">
                                <TextBlock Text="−♩" FontFamily="{StaticResource MusicFont}" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource PaletteButton}" Click="InsertBar_Click" ToolTip="Aggiungi una battuta dopo questa (Ctrl+Ins)">
                                <TextBlock Text="+|" FontSize="15" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource PaletteButton}" Click="DeleteBar_Click" ToolTip="Elimina la battuta (Ctrl+Maiusc+Canc)">
                                <TextBlock Text="−|" FontSize="15" FontWeight="SemiBold"/>
                            </Button>
                            <Button Style="{StaticResource PaletteButton}" Content="&#xE73E;" FontFamily="{StaticResource IconFont}" Click="FixBar_Click"
                                    ToolTip="Correggi la battuta: aggiunge pause o toglie i tempi in eccesso (Ctrl+F)"/>
                        </WrapPanel>

                        <Button Style="{StaticResource ToolButton}" Margin="0,20,6,0" Click="Help_Click" ToolTip="Apre la guida con tutte le scorciatoie (F1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Scorciatoie  ·  F1"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Spartito + manico -->
            <Grid x:Name="ScoreArea" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition x:Name="FretDividerRow" Height="0"/>
                    <RowDefinition x:Name="FretRow" Height="0"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource Paper}" Margin="10,10,10,6" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <at:AlphaTab x:Name="Tab" BarCursorFill="{StaticResource ScoreBarCursor}" BeatCursorFill="{StaticResource ScoreBeatCursor}" SelectionFill="{StaticResource ScoreSelection}"
                                     PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"/>
                        <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True">
                            <Canvas x:Name="SelectionLayer"/>
                            <Rectangle x:Name="ColumnMark" Fill="{StaticResource EditorColumnMark}" RadiusX="3" RadiusY="3" Visibility="Collapsed"/>
                            <Rectangle x:Name="CellMark" Stroke="{StaticResource EditorCellBorder}" StrokeThickness="2" Fill="{StaticResource EditorCellFill}" RadiusX="3" RadiusY="3" Visibility="Collapsed"/>
                        </Canvas>
                        <!-- Avviso temporaneo, ben visibile sopra lo spartito -->
                        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Background="{StaticResource ToastBackground}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="9" Padding="16,11"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="{StaticResource ShadowColor}"/>
                            </Border.Effect>
                            <DockPanel>
                                <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                           Foreground="{StaticResource Accent}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="ToastText" Foreground="{StaticResource TextMain}" FontSize="14.5" LineHeight="21"
                                           TextWrapping="Wrap" MaxWidth="520"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="ScoreAttribution" Grid.Row="1" Text="alphaTab.net" FontSize="13" Foreground="{StaticResource LineStrong}"
                                   HorizontalAlignment="Right" Margin="6,0,12,2" ToolTip="Motore di notazione alphaTab.net"/>
                    </Grid>
                </Border>
                <GridSplitter x:Name="FretSplitter" Grid.Row="1" Style="{StaticResource HorizontalPanelSplitter}" Visibility="Collapsed" DragCompleted="HeightSplitter_DragCompleted" KeyUp="HeightSplitter_KeyUp" AutomationProperties.Name="Altezza del manico" ToolTip="Altezza del manico: trascina oppure usa le frecce; alternative in Altro → Spazio partitura"/>
                <Border x:Name="FretPanel" Grid.Row="2" Background="{StaticResource BgPanel}" Margin="10,0,10,6"
                        CornerRadius="6" Padding="8,6" Visibility="Collapsed">
                    <views:FretboardView x:Name="Fretboard"/>
                </Border>
            </Grid>

            <GridSplitter x:Name="PaletteSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Left" Background="{StaticResource TransparentFill}"
                          ResizeBehavior="PreviousAndCurrent" ResizeDirection="Columns" Cursor="SizeWE" DragCompleted="SideSplitter_DragCompleted" ToolTip="Trascina per allargare la tavolozza"/>
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Right" Background="{StaticResource TransparentFill}"
                          ResizeBehavior="CurrentAndNext" ResizeDirection="Columns" Cursor="SizeWE" DragCompleted="SideSplitter_DragCompleted" ToolTip="Trascina per allargare il pannello"/>

            <!-- Pannello proprietà -->
            <Border x:Name="InspectorPanel" Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Margin="12,12,12,0" Background="{StaticResource BgDeep}" CornerRadius="7" Padding="3">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="TabSong" Content="BRANO" GroupName="insp" IsChecked="True" Checked="InspectorTab_Checked" Style="{StaticResource InspectorTab}"/>
                        <RadioButton x:Name="TabTrack" Content="TRACCIA" GroupName="insp" Checked="InspectorTab_Checked" Style="{StaticResource InspectorTab}"/>
                        <RadioButton x:Name="TabBar" Content="BATTUTA" GroupName="insp" Checked="InspectorTab_Checked" Style="{StaticResource InspectorTab}"/>
                    </UniformGrid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Grid Margin="16,0,14,16">
                            <!-- Brano -->
                            <StackPanel x:Name="SongPage">
                                <TextBlock Text="Informazioni" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="Titolo" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TitleBox" KeyDown="SongField_KeyDown" LostFocus="SongField_LostFocus"/>
                                <TextBlock Text="Artista" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ArtistBox" KeyDown="SongField_KeyDown" LostFocus="SongField_LostFocus"/>
                                <TextBlock Text="Velocità iniziale (BPM)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TempoStartBox" Width="90" HorizontalAlignment="Left" KeyDown="SongField_KeyDown" LostFocus="SongField_LostFocus"/>
                                <TextBlock Text="Riepilogo" Style="{StaticResource PanelHeader}"/>
                                <TextBlock x:Name="SongSummary" Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Traccia -->
                            <StackPanel x:Name="TrackPage" Visibility="Collapsed">
                                <TextBlock Text="Traccia" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TrackNameBox" KeyDown="TrackField_KeyDown" LostFocus="TrackField_Changed"/>
                                <TextBlock Text="Suono" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="TrackSoundCombo" SelectionChanged="TrackField_Changed" Focusable="False"/>
                                <TextBlock Text="Accordatura" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="TrackTuningCombo" SelectionChanged="TrackField_Changed" Focusable="False"/>
                                <TextBlock Text="Capotasto" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="TrackCapoCombo" Width="130" HorizontalAlignment="Left" SelectionChanged="TrackField_Changed" Focusable="False"/>
                                <TextBlock x:Name="TrackInfo" Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>

                            <!-- Battuta -->
                            <StackPanel x:Name="BarPage" Visibility="Collapsed">
                                <TextBlock x:Name="BarHeader" Text="Battuta 1" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="Velocità" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="BarTempoCheck" Content="Cambia a" VerticalAlignment="Center" Margin="0"/>
                                    <TextBox x:Name="BarTempoBox" Width="64" Margin="8,0,6,0"/>
                                    <TextBlock Text="BPM" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Tempo in chiave" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="BarNumBox" Width="48"/>
                                    <TextBlock Text="/" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="6,0"/>
                                    <ComboBox x:Name="BarDenCombo" Width="74" Focusable="False">
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="16"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Ritornello" Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="BarRepeatStartCheck" Content="Inizio ritornello  ‖:"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="BarRepeatEndCheck" Content="Fine  :‖  ripeti" VerticalAlignment="Center" Margin="0"/>
                                    <TextBox x:Name="BarRepeatCountBox" Width="44" Margin="8,0,6,0" Text="2"/>
                                    <TextBlock Text="volte" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Sezione (Intro, Strofa, Assolo…)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BarSectionBox"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Applica alla battuta" Margin="0,18,0,0" Click="BarApply_Click"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================== TRACCE ============================== -->
        <GridSplitter x:Name="TracksSplitter" Grid.Row="2" Style="{StaticResource HorizontalPanelSplitter}" DragCompleted="HeightSplitter_DragCompleted" KeyUp="HeightSplitter_KeyUp" AutomationProperties.Name="Altezza delle tracce" ToolTip="Altezza delle tracce: trascina oppure usa le frecce; alternative in Altro → Spazio partitura"/>
        <Border x:Name="TracksPanel" Grid.Row="3" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Le colonne vengono create dal codice, uguali a quelle delle righe (TrackColumnWidths) -->
                <Grid x:Name="TracksHeader" DockPanel.Dock="Top" Height="28" Background="{StaticResource BgDark}">
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="13" Width="28" Height="26" Click="AddTrack_Click" ToolTip="Aggiungi una traccia (Ctrl+Maiusc+N)"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Width="28" Height="26" Click="DeleteTrack_Click" ToolTip="Elimina traccia (Ctrl+Maiusc+D)"/>
                        <TextBlock Text="Tracce" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="M" Foreground="{StaticResource TextDim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mute: silenzia la traccia"/>
                    <TextBlock Grid.Column="3" Text="S" Foreground="{StaticResource TextDim}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Solo: ascolta solo questa traccia"/>
                    <TextBlock Grid.Column="4" Text="Volume" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="6" Text="Battute  ·  clicca per andarci" Foreground="{StaticResource TextDim}" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer x:Name="TracksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="TrackRows"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== STATO ============================== -->
        <Border x:Name="StatusBar" Grid.Row="4" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4,8,4">
            <DockPanel>
                <ComboBox x:Name="ZoomCombo" DockPanel.Dock="Right" Width="92" Height="28" MinHeight="28" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                          SelectedIndex="2" Focusable="False" SelectionChanged="ZoomCombo_SelectionChanged" ToolTip="Zoom dello spartito">
                    <ComboBoxItem Content="70%" Tag="0.7"/>
                    <ComboBoxItem Content="85%" Tag="0.85"/>
                    <ComboBoxItem Content="100%" Tag="1"/>
                    <ComboBoxItem Content="120%" Tag="1.2"/>
                    <ComboBoxItem Content="150%" Tag="1.5"/>
                    <ComboBoxItem Content="200%" Tag="2"/>
                </ComboBox>
                <ComboBox x:Name="ViewCombo" DockPanel.Dock="Right" Width="150" Height="28" MinHeight="28" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"
                          SelectedIndex="1" Focusable="False" SelectionChanged="ViewCombo_SelectionChanged" ToolTip="Cosa mostrare: tablatura, spartito o entrambi">
                    <ComboBoxItem Content="Tab + spartito"/>
                    <ComboBoxItem Content="Solo tab"/>
                    <ComboBoxItem Content="Solo spartito"/>
                </ComboBox>
                <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" FontSize="13" Text="Caricamento del motore audio…"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
