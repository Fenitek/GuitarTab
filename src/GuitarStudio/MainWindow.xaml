<Window x:Class="GuitarStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GuitarStudio.Views"
        Title="GuitarStudio" Height="800" Width="1280" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra laterale -->
        <DockPanel Background="{StaticResource BgPanel}">
            <StackPanel DockPanel.Dock="Top" Margin="20,22,20,26">
                <TextBlock Text="GuitarStudio" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="tab · pratica · allenamento" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Text="v0.1" Foreground="{StaticResource TextDim}" Margin="20,0,0,14" FontSize="11"/>
            <StackPanel>
                <RadioButton x:Name="NavPractice" Style="{StaticResource NavButton}" Content="🎸  Tab &amp; Pratica" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTrainer" Style="{StaticResource NavButton}" Content="🎯  Allenatore" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTranscribe" Style="{StaticResource NavButton}" Content="🎧  Trascrivi MP3" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Content="📚  Libreria" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Contenuto -->
        <Grid Grid.Column="1">
            <views:PracticeView x:Name="PracticePage"/>
            <views:ComingSoonView x:Name="TrainerPage" Visibility="Collapsed"
                Heading="Allenatore"
                Description="Collega la chitarra (Blackstar ID:Core via USB) e suona sopra la tab: il programma ti dirà se sei a tempo e quali note sbagli."/>
            <views:ComingSoonView x:Name="TranscribePage" Visibility="Collapsed"
                Heading="Trascrivi MP3"
                Description="Carica un MP3: separazione di voce, chitarra, basso e batteria, riconoscimento accordi e bozza di tablatura da aprire nell&apos;editor."/>
            <views:ComingSoonView x:Name="LibraryPage" Visibility="Collapsed"
                Heading="Libreria"
                Description="Tutte le tue canzoni con tab, BPM originale, BPM raggiunto, storico delle sessioni e note personali."/>
        </Grid>
    </Grid>
</Window>
