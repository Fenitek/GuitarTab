<Window x:Class="GuitarStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GuitarStudio.Views"
        Title="GuitarStudio" Height="900" Width="1500" MinWidth="880" MinHeight="480"
        Icon="pack://application:,,,/Assets/GuitarStudio.ico"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barra di navigazione -->
        <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,14">
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Accent}" ToolTip="GuitarStudio">
                        <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="19" Width="44" Height="40" Click="Help_Click"
                            ToolTip="Guida rapida e scorciatoie (F1)"/>
                    <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{StaticResource TextDim}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0" ToolTip="Versione di GuitarStudio"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="NavPractice" Style="{StaticResource NavButton}" Tag="&#xE70F;" Content="Tab" IsChecked="True" Checked="Nav_Checked"
                                 ToolTip="Tab &amp; Pratica: scrivi, apri e studia le tablature"/>
                    <RadioButton x:Name="NavSheet" Style="{StaticResource NavButton}" Tag="&#xE736;" Content="Accordi" Checked="Nav_Checked"
                                 ToolTip="Fogli di accordi: testo della canzone con gli accordi sopra, giri e lettura a caratteri grandi"/>
                    <RadioButton x:Name="NavTrainer" Style="{StaticResource NavButton}" Tag="&#xE720;" Content="Allenatore" Checked="Nav_Checked"
                                 ToolTip="Allenatore: suona con la chitarra collegata (in arrivo)"/>
                    <RadioButton x:Name="NavTranscribe" Style="{StaticResource NavButton}" Tag="&#xE8D6;" Content="Trascrivi" Checked="Nav_Checked"
                                 ToolTip="Trascrivi MP3: da un file audio a una bozza di tablatura (in arrivo)"/>
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Libreria" Checked="Nav_Checked"
                                 ToolTip="Libreria: i tuoi brani e i progressi (in arrivo)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenuto -->
        <Grid Grid.Column="1">
            <views:PracticeView x:Name="PracticePage"/>
            <views:ChordSheetView x:Name="SheetPage" Visibility="Collapsed"/>
            <views:ComingSoonView x:Name="TrainerPage" Visibility="Collapsed" Glyph="&#xE720;"
                Heading="Allenatore"
                Description="Collega la chitarra (Blackstar ID:Core via USB) e suona sopra la tab: il programma ti dirà se sei a tempo e quali note sbagli."/>
            <views:ComingSoonView x:Name="TranscribePage" Visibility="Collapsed" Glyph="&#xE8D6;"
                Heading="Trascrivi MP3"
                Description="Carica un MP3: separazione di voce, chitarra, basso e batteria, riconoscimento accordi e bozza di tablatura da aprire nell&apos;editor."/>
            <views:ComingSoonView x:Name="LibraryPage" Visibility="Collapsed" Glyph="&#xE8F1;"
                Heading="Libreria"
                Description="Tutte le tue canzoni con tab, BPM originale, BPM raggiunto, storico delle sessioni e note personali."/>
        </Grid>
    </Grid>
</Window>
